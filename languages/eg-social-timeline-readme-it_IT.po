msgstr "Shortcode con parametro di limite facoltativo"

msgid "Responsive design"
msgstr "Design responsive"

msgid "Text, borders and icons derived from the contrast of the color you pick, so they stay readable"
msgstr "Testo, bordi e icone derivati dal contrasto del colore che scegli, così restano leggibili"

msgid "Timeline and card backgrounds configurable independently, each with its own color"
msgstr "Sfondo della timeline e sfondo delle schede configurabili in modo indipendente, ciascuno con il proprio colore"

msgid "Configurable cache (30 minutes - 24 hours)"
msgstr "Cache configurabile (da 30 minuti a 24 ore)"

msgid "Interaction stats: likes, boosts, comments"
msgstr "Contatori di interazione: like, boost, commenti"

msgid "Per-platform configurable limits for a balanced mix"
msgstr "Limiti configurabili per piattaforma, per un mix equilibrato"

msgid "Image previews wherever the source carries one: Mastodon, Bluesky, Pixelfed, PeerTube thumbnails and images found in a feed (optional, per source)"
msgstr "Anteprime immagini ovunque la fonte ne porti una: Mastodon, Bluesky, Pixelfed, miniature PeerTube e immagini trovate in un feed (facoltative, per fonte)"

msgid "Interactive per-platform filters, no JavaScript required"
msgstr "Filtri interattivi per piattaforma, senza JavaScript"

msgid "Any RSS 2.0 or Atom feed: a blog, a newsletter, a podcast"
msgstr "Qualsiasi feed RSS 2.0 o Atom: un blog, una newsletter, un podcast"

msgid "ListenBrainz (public API, no token: what you have been listening to)"
msgstr "ListenBrainz (API pubblica, senza token: quello che hai ascoltato)"

msgid "Lemmy, on any instance (public user RSS feed)"
msgstr "Lemmy, su qualsiasi istanza (feed RSS pubblico dell'utente)"

msgid "Forgejo and Gitea (commits from your public repositories)"
msgstr "Forgejo e Gitea (commit dai tuoi repository pubblici)"

msgid "PeerTube (public REST API, videos from an account or from a channel)"
msgstr "PeerTube (API REST pubblica, video da un account o da un canale)"

msgid "Pixelfed (public Atom feed: photos and captions, no interaction counts)"
msgstr "Pixelfed (feed Atom pubblico: foto e didascalie, senza contatori di interazione)"

msgid "Bluesky (public API, no authentication required)"
msgstr "Bluesky (API pubblica, nessuna autenticazione richiesta)"

msgid "Mastodon, and the Mastodon-compatible Pleroma and Akkoma (public accounts API, no authentication)"
msgstr "Mastodon, e i compatibili Pleroma e Akkoma (API pubblica degli account, nessuna autenticazione)"

