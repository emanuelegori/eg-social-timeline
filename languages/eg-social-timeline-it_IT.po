msgstr "Repository"

msgid "License GPL-2.0-or-later"
msgstr "Licenza GPL-2.0-or-later"

msgid "Cache flushed successfully!"
msgstr "Cache svuotata!"

msgid "EG Social Timeline - Configuration Required"
msgstr "EG Social Timeline — Configurazione richiesta"

msgid "EG Social Timeline — Configuration Required"
msgstr "EG Social Timeline — Configurazione richiesta"

msgid "No social profile configured."
msgstr "Nessun profilo social configurato."

msgid "No posts available at the moment."
msgstr "Nessun post disponibile al momento."

msgid "Filter by platform:"
msgstr "Filtra per piattaforma:"

msgid "Attached image"
msgstr "Immagine allegata"

msgid "Points"
msgstr "Punti"

msgid "Favourites"
msgstr "Preferiti"

msgid "Boost"
msgstr "Boost"

msgid "Comments"
msgstr "Commenti"

msgid "Replies"
msgstr "Risposte"

msgid "View commit"
msgstr "Vedi commit"

msgid "View original post"
msgstr "Vedi post originale"

