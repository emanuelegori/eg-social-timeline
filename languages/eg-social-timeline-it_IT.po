msgid_plural "Cache flushed and rebuilt: %d items retrieved."
msgstr[0] "Cache svuotata e ricostruita: %d contenuto recuperato."
msgstr[1] "Cache svuotata e ricostruita: %d contenuti recuperati."

#: eg-social-timeline.php:2214
msgid "The instance requires authentication for the accounts API."
msgstr "L'istanza richiede l'autenticazione per l'API degli account."

#. translators: 1: nome utente cercato, 2: codice di stato HTTP
#: eg-social-timeline.php:2227
