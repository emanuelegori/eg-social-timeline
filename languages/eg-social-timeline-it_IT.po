#. Plugin Name of the plugin
#: eg-social-timeline.php eg-social-timeline.php:51 eg-social-timeline.php:52
msgid "EG Social Timeline"
msgstr "EG Social Timeline"

#. Plugin URI of the plugin
#: eg-social-timeline.php
msgid "https://git.emanuelegori.uno/emanuelegori/eg-social-timeline"
msgstr ""

#. Description of the plugin
#: eg-social-timeline.php
msgid ""
"Unified chronological timeline of your public activity from Mastodon, "
"Bluesky, Forgejo and Diggita. Zero JavaScript, zero tracking."
msgstr ""
"Timeline cronologica unificata delle tue attività pubbliche da Mastodon, "
"Bluesky, Forgejo e Diggita. Zero JavaScript, zero tracciamento."

#. Author of the plugin
#: eg-social-timeline.php
msgid "Emanuele Gori"
msgstr ""

#. Author URI of the plugin
#: eg-social-timeline.php
msgid "https://emanuelegori.uno"
msgstr ""

#: eg-social-timeline.php:90
msgid "Social Profiles Configuration"
msgstr "Configurazione profili social"

#: eg-social-timeline.php:97
msgid "Mastodon Profile URL"
msgstr "URL profilo Mastodon"

#: eg-social-timeline.php:105
msgid "Diggita Username"
msgstr "Username Diggita"

