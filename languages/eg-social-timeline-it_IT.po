msgstr "https://git.emanuelegori.uno/emanuelegori/eg-social-timeline"

#. Description of the plugin
#: eg-social-timeline.php
msgid ""
"Unified chronological timeline of your public activity from Mastodon, "
"Bluesky, PeerTube, Forgejo and Lemmy. Zero JavaScript, zero tracking."
msgstr ""
"Timeline cronologica unificata delle tue attività pubbliche da Mastodon, "
"Bluesky, PeerTube, Forgejo e Lemmy. Zero JavaScript, zero tracciamento."

#. Author of the plugin
#: eg-social-timeline.php
msgid "Emanuele Gori"
msgstr "Emanuele Gori"

