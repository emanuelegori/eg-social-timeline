msgid_plural "%s minutes ago"
msgstr[0] "%s minuto fa"
msgstr[1] "%s minuti fa"

msgid "%s hour ago"
msgid_plural "%s hours ago"
msgstr[0] "%s ora fa"
msgstr[1] "%s ore fa"

msgid "%s day ago"
msgid_plural "%s days ago"
msgstr[0] "%s giorno fa"
