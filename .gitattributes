# Archivi di release puliti: fuori i file di sviluppo, dentro la licenza e il
# README che accompagnano il plugin installato.
# Elenco esplicito e non *.md: il glob escludeva anche LICENSE.md e README.md.
.gitattributes export-ignore
.gitignore export-ignore
.forgejo/ export-ignore
tests/ export-ignore
/CHANGELOG.md export-ignore
/README.it-IT.md export-ignore
/LICENSE.IT.md export-ignore
# Asset della pagina WordPress.org (screenshot, banner, icona): stanno nel
# repository, non nel pacchetto che scaricano gli utenti.
assets/ export-ignore
# Traduzione italiana fuori dal pacchetto: su WordPress.org le traduzioni le
# genera e le distribuisce translate.wordpress.org, e i file inclusi nel
# plugin sono stati segnalati in revisione. Il .po resta qui per chi lavora
# dal repository; il .pot serve ai traduttori e resta nel pacchetto.
/languages/eg-social-timeline-it_IT.po export-ignore
/languages/eg-social-timeline-it_IT.mo export-ignore
